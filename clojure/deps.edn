
{
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}
 :aliases
 {

  :splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.25.0"}}
           :main-opts ["-m" "noahtheduke.splint"]}

  :rephrase {:extra-deps {org.corfield/rephrase {:mvn/version "1.0.7"}}}

  :repl/cli {:extra-deps {io.github.clojure/clojure-cli.repl-server {:mvn/version "0.2.3"}}
             :main-opts ["-m" "clojure-cli.repl.server" "repl"]}
  :serve/cli {:extra-deps {io.github.clojure/clojure-cli.repl-server {:mvn/version "0.2.3"}}
              :main-opts ["-m" "clojure-cli.repl.server"]}
  :attach/cli {:replace-paths []
               :replace-deps {io.github.clojure/clojure-cli.repl-client {:mvn/version "0.2.3"}}
               :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
               :main-opts ["-m" "clojure-cli.repl.client"]}

  :portal {:extra-deps {djblue/portal {:mvn/version "0.64.1"}}}

  :performance¬ {:extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                              com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.4.0"}}
                 :jvm-opts ["-Djdk.attach.allowAttachSelf"]}
  ,}}
